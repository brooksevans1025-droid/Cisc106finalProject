import requests
#installed for making HTTP requests to fetch bus data from an API.

from bs4 import BeautifulSoup
#installed for parsing HTML and XML documents, useful for extracting data from web pages.

url = "https://udbusmobile.etaspot.net/index.php?content=route"
#this is the URL of the webpage that has UD bus route information as plain txt.

response = requests.get(url)
#makes a GET request to the specified URL and stores the response in the variable 'response'.


if response.status_code == 200:
    #this is to check if the request was successful (status code 200 means OK).
    print("Request was successful!")
    print(response.text)
    #this prints the raw HTML content of the response to the console.
    soup = BeautifulSoup(response.text, 'html.parser')
    #this creates a BeautifulSoup object from the response text, allowing for easy parsing of the HTML content.
    if soup.title is not None:
        print(soup.title.text)
        #this is because .text cant be called on NoneType.
    #this prints the title of the webpage to the console, which is extracted from the <title> tag in the HTML.
else:
    print("Failed to retrieve data. Status code:", response.status_code)
    

